) AS noofproj;

-- Q7
SELECT
projno,
projname,
prendate,
remark
FROM(
SELECT
sub.projno,
sub.projname,
sub.prendate,
sub.projname AS 'Sub-project',
CASE
WHEN sub.majproj IS NOT NULL THEN 'Sub-project'
ELSE 'Not a sub-project'
END AS remark
FROM Proj p
LEFT JOIN Proj sub ON p.projno = sub.majproj
) AS subornotsub
ORDER BY prendate ASC;


