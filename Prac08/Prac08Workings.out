		IF NEW.salary < 24000 THEN
				SIGNAL SQLSTATE '45000'
					SET MESSAGE_TEXT = err_msg_less_24k;
		END IF;
	END                                                                                                                                                                                                                                                                                                                                       | BEFORE | 2026-10-09 10:15:03.22 | ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION | dsuser@localhost | utf8mb4              | utf8mb4_0900_ai_ci   | utf8mb4_0900_ai_ci |
