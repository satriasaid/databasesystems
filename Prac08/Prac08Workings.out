		DECLARE err_msg_less_24k VARCHAR(100);
		SET err_msg_less_24k = CONCAT('The new salary, ', NEW.salary, ' cannot be lower than 24000');
		IF NEW.salary < 24000 THEN
				SIGNAL SQLSTATE '45000'
					SET MESSAGE_TEXT = err_msg_less_24k;
		END IF;
	END                                                                                                                                                                                                                                                                                                                                       | BEFORE | 2026-10-09 10:15:03.20 | ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION | dsuser@localhost | utf8mb4              | utf8mb4_0900_ai_ci   | utf8mb4_0900_ai_ci |
| after_emp_update_total2 | UPDATE | Emp1  | BEGIN
		IF OLD.salary IS NOT NULL
			AND NEW.salary IS NOT NULL THEN
				UPDATE Dept1
				SET total_sal = total_sal + NEW.salary - OLD.salary
				WHERE dept_no = NEW.dept_no;
		END IF;
	END                                                                                                                                                                                                                                                                                                                                                                                                          | AFTER  | 2026-10-09 10:07:08.23 | ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION | dsuser@localhost | utf8mb4              | utf8mb4_0900_ai_ci   | utf8mb4_0900_ai_ci |
| after_emp_update_total3 | UPDATE | Emp1  | BEGIN
		
		IF OLD.salary IS NOT NULL
			AND NEW.salary IS NOT NULL THEN
				UPDATE Dept1
				SET total_sal = total_sal + NEW.salary - OLD.salary
				WHERE dept_no = NEW.dept_no;
		
		
		
		ELSEIF (NEW.salary IS NULL AND OLD.salary IS NOT NULL)
			THEN
				UPDATE Dept1
				SET total_sal = total_sal - OLD.salary
				WHERE dept_no = OLD.dept_no;
		
		
		ELSEIF (NEW.salary IS NOT NULL AND OLD.salary IS NULL)
			THEN
				UPDATE Dept1
				SET total_sal = total_sal + NEW.salary
				WHERE dept_no = NEW.dept_no;
		
		
		ELSE
			UPDATE Dept1
			SET total_sal = total_sal;
		END IF;
	END | AFTER  | 2026-10-09 10:07:14.23 | ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION | dsuser@localhost | utf8mb4              | utf8mb4_0900_ai_ci   | utf8mb4_0900_ai_ci |
| after_emp_delete_total2 | DELETE | Emp1  | BEGIN
		IF OLD.dept_no IS NOT NULL
			AND OLD.salary IS NOT NULL THEN
			UPDATE Dept1
			SET total_sal = total_sal - OLD.salary
			WHERE dept_no = OLD.dept_no;
		END IF;
	END                                                                                                                                                                                                                                                                                                                                                                                                                         | AFTER  | 2026-10-09 10:08:08.28 | ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION | dsuser@localhost | utf8mb4              | utf8mb4_0900_ai_ci   | utf8mb4_0900_ai_ci |
