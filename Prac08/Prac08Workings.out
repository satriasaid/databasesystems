					WHERE dept_no = NEW.dept_no;
			END IF;
		END                                                                                                                                                                                                                                                                                                                                                                                                                                                | AFTER  | 2026-10-09 10:07:00.99 | ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION | dsuser@localhost | utf8mb4              | utf8mb4_0900_ai_ci   | utf8mb4_0900_ai_ci |
